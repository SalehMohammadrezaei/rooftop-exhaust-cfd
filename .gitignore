# OpenFOAM case output and large files are never committed
*/processor*/
processor*/
[0-9]*.[0-9]*/
!0/
!0.orig/
log.*
*.log
postProcessing/
VTK/
*.vtk
*.vtu
*.vtp
*.foam
*.OpenFOAM
constant/polyMesh/
constant/extendedFeatureEdgeMesh/
constant/triSurface/*.eMesh
dynamicCode/
*.gz
*.tgz
*.zip
*.stl
*.obj
__pycache__/
*.pyc
.venv/
.iotest*
data/raw/irsst_r848/*.pdf

# generated figure sources that are too large or regenerable
results/**/figures_test/

# interpolated initial fields (setExprFields) are regenerated from 0.orig; slice-figure PDFs are too heavy
**/0/U
results/applied/figures/fields_*.pdf

# time directories without a decimal point (e.g. 2000/) were not caught by the pattern above
[1-9]*/
