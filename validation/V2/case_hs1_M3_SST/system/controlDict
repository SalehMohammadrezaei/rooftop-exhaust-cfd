/*  V2 step 7: run control and monitors.  */
FoamFile { version 2.0; format ascii; class dictionary; object controlDict; }
application     simpleFoam;
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         2500;
deltaT          1;
writeControl    timeStep;
writeInterval   500;
purgeWrite      0;
writeFormat     ascii;
writePrecision  10;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable yes;
functions
{
    #include "samplePoints"
    #include "scalarTransport"
    #include "plumeLines"
    probesRoof          // primary quantities: U and the tracers at three receptors (5, 20, 50 m full scale) and in the jet
    {
        type probes; libs (sampling); fields (U k s04 s07); writeControl timeStep;
        probeLocations ( (-0.2225 0 0.076) (-0.1475 0 0.076) (0.0025 0 0.076) (-0.2475 0 0.09) );
    }
    forcesBuilding { type forces; libs (forces); patches (building); rho rhoInf; rhoInf 1.2; CofR (-0.125 0 0.0375); writeControl timeStep; log false; }
    flowIn  { type surfaceFieldValue; libs (fieldFunctionObjects); regionType patch; name inlet;      operation sum; fields (phi); writeControl writeTime; writeFields false; log false; }
    flowOut { type surfaceFieldValue; libs (fieldFunctionObjects); regionType patch; name outlet;     operation sum; fields (phi); writeControl writeTime; writeFields false; log false; }
    flowStack { type surfaceFieldValue; libs (fieldFunctionObjects); regionType patch; name stack_exit; operation sum; fields (phi); writeControl writeTime; writeFields false; log false; }
    minMax  { type fieldMinMax; libs (fieldFunctionObjects); fields (U k s04); writeControl timeStep; writeInterval 10; log false; }
}
