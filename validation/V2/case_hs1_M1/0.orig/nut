/*  V2 step 4: turbulent viscosity: smooth-wall functions on the three walls, calculated elsewhere.  */
FoamFile { version 2.0; format ascii; class volScalarField; object nut; }
dimensions      [0 2 -1 0 0 0 0];
internalField   uniform 0;
boundaryField
{
    inlet       { type calculated; value uniform 0; }
    outlet      { type calculated; value uniform 0; }
    top         { type calculated; value uniform 0; }
    sides       { type calculated; value uniform 0; }
    stack_exit  { type calculated; value uniform 0; }
    ground      { type nutkWallFunction; value uniform 0; }
    building    { type nutkWallFunction; value uniform 0; }
    stack_wall  { type nutkWallFunction; value uniform 0; }
}
