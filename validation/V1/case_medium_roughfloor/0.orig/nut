/*  Step 4f: turbulent viscosity.  Not solved for; computed by the model from k and epsilon/omega.
    Its file exists because the WALL FUNCTION for velocity lives here: at a wall, nut is set so that
    the wall shear stress follows the log law (entry 7 of the notebook, smooth-wall version).      */
FoamFile { version 2.0; format ascii; class volScalarField; object nut; }

dimensions      [0 2 -1 0 0 0 0];        // m2/s, like nu

internalField   uniform 0;

boundaryField
{
    inlet       { type calculated; value uniform 0; }   // "calculated": the model fills it in, nothing imposed
    outlet      { type calculated; value uniform 0; }
    top         { type calculated; value uniform 0; }
    sides       { type calculated; value uniform 0; }

    ground      { type atmNutkWallFunction; z0 uniform 0.0117; kappa 0.4; Cmu 0.09; value uniform 0; }   // ROUGH FLOOR SENSITIVITY (decision 0005): z0 from the log-law fit of the approach flow
    building    { type nutkWallFunction; value uniform 0; }
}
