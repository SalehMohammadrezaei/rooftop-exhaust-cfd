/*  Step 4d: turbulent kinetic energy.  Same six patches; inlet from the measured table,
    walls through a wall function, outlet guarded, top and sides slip.                          */
FoamFile { version 2.0; format ascii; class volScalarField; object k; }

dimensions      [0 2 -2 0 0 0 0];        // m2/s2

internalField   uniform 0.45;            // the measured value at roof height; a reasonable guess everywhere

boundaryField
{
    inlet
    {
        type            fixedProfile;
        profile         csvFile;
        profileCoeffs
        {
            file                "<constant>/inletProfiles/k.csv";
            nHeaderLine         1;
            refColumn           0;
            componentColumns    (1);     // one column: k
            separator           ",";
            mergeSeparators     no;
            outOfBounds         clamp;
            interpolationScheme linear;
        }
        direction       (0 0 1);
        origin          0;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }

    ground      { type kqRWallFunction; value $internalField; }   // zero gradient at a wall; the name says "k, q, R wall function"

    top         { type slip; }
    sides       { type slip; }
}
