/*  Step 4c: pressure.  simpleFoam is incompressible, so p here is pressure divided by density
    (kinematic pressure, m2/s2).  Only its differences matter, so one patch fixes the level.      */
FoamFile { version 2.0; format ascii; class volScalarField; object p; }

dimensions      [0 2 -2 0 0 0 0];        // m2/s2 = Pa / (kg/m3)

internalField   uniform 0;

boundaryField
{
    inlet       { type zeroGradient; }   // velocity is imposed here, so pressure must be free
    outlet      { type fixedValue; value uniform 0; }   // the one place the level is set: p = 0 at the exit
    ground      { type zeroGradient; }   // no flow through a wall -> no pressure gradient normal to it
    building    { type zeroGradient; }
    top         { type zeroGradient; }
    sides       { type zeroGradient; }
}
