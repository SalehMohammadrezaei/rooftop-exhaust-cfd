/*  Tracer transport on the converged flow (decision 0004): six passive scalars, one per Sct.
    D = nu + nut/Sct (alphaDt = 1/Sct).  Source: Q = 5.83e-6 m3/s of tracer injected into the cell
    containing the floor hole at (0.05, 0, 0): C* = s U_H H^2 / Q is then directly comparable.  */
s04Transport
{
    type            scalarTransport;
    libs            (solverFunctionObjects);
    field           s04;
    schemesField    s;              // all tracers share the div(phi,s) scheme and the "s" solver settings
    alphaD          1;              // molecular: D = nu
    alphaDt         2.500000;         // turbulent: nut / Sct, Sct = 0.4
    bounded01       false;
    resetOnStartUp  false;          // continue from the fields already written
    fvOptions
    {
        source
        {
            type            scalarSemiImplicitSource;
            selectionMode   points;
            points          ((0.05 0 0.003));   // the floor hole, 0.25H behind the leeward wall
            volumeMode      absolute;           // the rate below is the total, in field-units * m3/s
            sources         { s04 (5.83e-6 0); } // (Su Sp): explicit rate Q, no implicit part
        }
    }
    writeControl    writeTime;
}
