FoamFile { version 2.0; format ascii; class dictionary; object controlDict; }
libs            (atmosphericModels);
application     simpleFoam;
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         @endTime;
deltaT          1;
writeControl    timeStep;
writeInterval   @writeInterval;
purgeWrite      0;
writeFormat     ascii;
writePrecision  12;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable yes;
functions
{
    #include "sampleLines"
    minMax
    {
        type            fieldMinMax;
        libs            (fieldFunctionObjects);
        fields          (U k);
        writeControl    timeStep;
        writeInterval   10;
    }
    probeRoof
    {
        type            probes;
        libs            (sampling);
        fields          (U k);
        writeControl    timeStep;
        probeLocations  ( (@probeX @probeY @probeZ) );
    }
    flowIn  { type surfaceFieldValue; libs (fieldFunctionObjects); regionType patch; name inlet;  operation sum; fields (phi); writeControl writeTime; writeFields false; log false; }
    flowOut { type surfaceFieldValue; libs (fieldFunctionObjects); regionType patch; name outlet; operation sum; fields (phi); writeControl writeTime; writeFields false; log false; }
}
