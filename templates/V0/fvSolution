FoamFile { version 2.0; format ascii; class dictionary; object fvSolution; }
// Numerical: linear solvers and relaxation from the official atmDownstreamDevelopment tutorial;
// residualControl added (the tutorial ran a fixed 5000 iterations).
solvers
{
    p                     { solver GAMG; smoother GaussSeidel; tolerance 1e-8; relTol 0.01; }
    "(U|k|epsilon|omega)" { solver smoothSolver; smoother GaussSeidel; tolerance 1e-8; relTol 0.01; }
}
SIMPLE
{
    nNonOrthogonalCorrectors 0;
    consistent               true;
    pRefCell                 0;
    pRefValue                0;
    residualControl { p @residualControl; U @residualControl; "(k|epsilon|omega)" @residualControl; }
}
relaxationFactors
{
    equations { U 0.9; "(k|epsilon|omega)" 0.7; }
}
cache { grad(U); }
